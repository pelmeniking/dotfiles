{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none"
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "light_cyan"
    },
    "key": {
      "width": 16
    },
    "bar": {
      "width": 12
    }
  },

  "modules": [
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "loadavg",
      "key": "󰓅 Load"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU"
    },
    {
      "type": "memory",
      "key": "󰘚 Memory",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "swap",
      "key": "󰓡 Swap",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "showIpv4": true,
      "showIpv6": false,
      "showLoop": false
    }
  ]
}
